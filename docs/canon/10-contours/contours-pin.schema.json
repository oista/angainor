{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contours-pin.schema.json",
  "title": "Project contours pin",
  "description": "docs/architecture/contours.yaml в проекте: в каких средах живёт проект и какая версия реестра Angainor подразумевается (ENV-10).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "registry_version", "environments"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "registry_version": {
      "type": "string",
      "description": "Git-тег Angainor, с реестром которого сверяется проект.",
      "minLength": 1
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["env", "purpose"],
        "properties": {
          "env": { "type": "string", "pattern": "^[a-z]{3}\\.(dev|test|prod)$" },
          "purpose": { "type": "string", "minLength": 1 },
          "data_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "description": "Классы данных, которые проект реально кладёт в эту среду. Должны входить в allowed_data_classes контура."
          }
        }
      }
    }
  }
}
