{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "angainor/rule",
  "$comment": "canon: DOC-2, DOC-8",
  "title": "YAML-шапка правила реестра (rules/**/<ID>-<slug>.md)",
  "description": "Машиночитаемая часть правила для агентов. Решение — ADR-0003. Текст для агента лежит в разделе «Для агента» файла, не в шапке.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "scope",
    "activation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*\\.)?[A-Z]{2,4}-[0-9]+$",
      "description": "Общее правило: AGT-6, DOC-7. Проектное: prodata.DB-1. Номер не используется повторно."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "Proposed",
        "Accepted",
        "Deprecated",
        "Superseded"
      ]
    },
    "scope": {
      "type": "string",
      "pattern": "^(shared|preset:[a-z][a-z0-9-]*|project:[a-z][a-z0-9-]*)$",
      "description": "shared — для всех проектов; project:<ключ> — только для одного"
    },
    "activation": {
      "enum": [
        "always",
        "globs",
        "on_request"
      ],
      "description": "Режим по умолчанию; профиль проекта может его переопределить"
    },
    "globs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Фразы пользователя, по которым срабатывает правило (для on_request)"
    },
    "norm": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]+$"
      },
      "description": "Правила канона, которые воплощает это правило. Если список не пуст, выключение в проекте требует waiver"
    },
    "check": {
      "type": [
        "string",
        "null"
      ],
      "description": "Проверка, которая ловит нарушение (скрипт, тест, хук). null — правило остаётся пожеланием"
    },
    "params": {
      "type": "object",
      "description": "Параметры по умолчанию; профиль проекта может их переопределить"
    },
    "since": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Версия Angainor, в которой правило появилось"
    },
    "deprecated_since": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Версия, с которой правило Deprecated; удаляется не раньше следующего выпуска"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]*\\.)?[A-Z]{2,4}-[0-9]+$"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]*\\.)?[A-Z]{2,4}-[0-9]+$"
      }
    },
    "enforce": {
      "type": "array",
      "description": "Привязка правила к событиям агента (хуки Cursor), git-хукам и стадиям CI. Инструмент копируется в проект",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "tool"
        ],
        "properties": {
          "event": {
            "enum": [
              "sessionStart",
              "sessionEnd",
              "beforeSubmitPrompt",
              "preToolUse",
              "postToolUse",
              "postToolUseFailure",
              "beforeShellExecution",
              "afterShellExecution",
              "beforeMCPExecution",
              "afterMCPExecution",
              "beforeReadFile",
              "afterFileEdit",
              "afterAgentResponse",
              "stop",
              "preCompact",
              "pre-commit",
              "commit-msg",
              "pre-push",
              "ci"
            ]
          },
          "matcher": {
            "type": "string",
            "minLength": 1,
            "description": "Регулярное выражение по имени инструмента (для pre/postToolUse)"
          },
          "tool": {
            "type": "string",
            "pattern": "^(tools|scripts)/[a-z0-9_]+\\.py$",
            "description": "Скрипт из tools/ или scripts/ Angainor; копируется в проект, зависит только от стандартной библиотеки"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Аргументы; {project}, {plan_prefix} (префикс плана из профиля), {arg1} (первый аргумент git-хука), {pr_range} (диапазон коммитов PR в CI)"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "fail": {
            "enum": [
              "open",
              "closed"
            ],
            "description": "open — ошибка хука не блокирует агента (по умолчанию)"
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Для event=ci: стадия, один файл angainor-<stage>.yml на стадию"
          },
          "when": {
            "enum": [
              "pull_request",
              "push"
            ],
            "description": "Для event=ci: когда запускать (ключ не `on` — в YAML 1.1 это булево значение) (push — в main/master)"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activation": {
            "const": "globs"
          }
        },
        "required": [
          "activation"
        ]
      },
      "then": {
        "required": [
          "globs"
        ],
        "properties": {
          "globs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation": {
            "const": "on_request"
          }
        },
        "required": [
          "activation"
        ]
      },
      "then": {
        "required": [
          "triggers"
        ],
        "properties": {
          "triggers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "pattern": "^project:"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]*\\.[A-Z]{2,4}-[0-9]+$"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
