{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "angainor/invariant",
  "$comment": "canon: ARC-1, TST-3",
  "title": "Реестр инвариантов проекта (docs/architecture/invariants.yaml)",
  "description": "Объединяет archpolicy PRODATA (Invariant / Rule) и матрицу ADR-045 moex-data-model. Идентификатор с префиксом проекта.",
  "type": "object",
  "required": [
    "project",
    "invariants"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Префикс идентификаторов: prodata, dams, clavis, shared"
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "statement",
          "adr",
          "severity",
          "status",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.INV-[0-9]{3,4}$"
          },
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "description": "Что всегда должно быть верно — одной фразой"
          },
          "rationale": {
            "type": "string",
            "description": "Зачем; ссылка на инцидент, если правило выросло из сбоя"
          },
          "adr": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,4}$"
          },
          "incident_ref": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "error",
              "warning"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "implemented-untested",
              "implemented",
              "waived"
            ],
            "description": "implemented — только если на каждом уровне есть проходящий и падающий пример (TST-3)"
          },
          "waiver_reason": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "advisory",
              "inline",
              "ci_gate"
            ],
            "default": "ci_gate",
            "description": "Когда проверка блокирует: совет до кода, при правке, в CI"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "level",
                "ref"
              ],
              "properties": {
                "level": {
                  "enum": [
                    "L1",
                    "L2",
                    "L3"
                  ],
                  "description": "L1 — простая проверка формы, L2 — проверка кодом, L3 — проверка на графе или в БД"
                },
                "ref": {
                  "type": "string",
                  "description": "Путь к проверке: скрипт, тест, правило"
                },
                "pass_example": {
                  "type": "string",
                  "description": "Путь к примеру, который должен пройти"
                },
                "fail_example": {
                  "type": "string",
                  "description": "Путь к примеру, который должен упасть"
                }
              },
              "additionalProperties": false
            }
          },
          "review_by": {
            "type": "string",
            "format": "date",
            "description": "Дата пересмотра правила"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "waived"
                }
              }
            },
            "then": {
              "required": [
                "waiver_reason"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
