# canon: CFG-1, CFG-2, CFG-3, CFG-6
# Сверяется со схемой docs/architecture/config-schema.yaml. Не редактировать вручную без схемы.
# Секреты здесь только в виде пустых значений: реальные значения — в .env (не в git).

# --- shared ---
PD_ENV=dev
PD_LOG_LEVEL=INFO
PD_LOG_FORMAT=text

# --- APP: база данных ---
APP_DB_URL=postgresql://user@localhost:5432/<db>

# --- APP: веб ---
APP_WEB_HOST=127.0.0.1
APP_WEB_PORT=8000
APP_WEB_SECRET_KEY=
